#pragma once 
#ifndef BRANDON_DANIELSON 
#define BRANDON_DANIELSON 

#include <cstddef> 
#include <stdexcept> 


template<typename T>
class MyVector{
private:
	T* elem; 
	std::size_t array_size; //how many elements are stored in the array (size()) 
	std::size_t space; // how many elements the array has room for (capacity, reserve()) 
public:
	MyVector(){ // by defualt no memory allocated
		elem = nullptr; 
		array_size = 0; 
		space = 0;
	}

	~MyVector(){
		delete[] elem; // runs automatically when vector goes out of scope
	}

	// prevent copying (prevent undefined behavior or memory leak) 
	MyVector(const MyVector&) = delete;  
	MyVector& operator=(const MyVector&) = delete; 

	// return the number of elements in container 
	std::size_t size() const{
		return array_size;
	
	}

	// return the allocated capacity 
	std::size_t capacity() const {

		return space;
	}

	void reserve(std::size_t new_capacity){
		if (new_capacity <= space) {
			return; // already big enough! nothing to do
		} 

		T* new_elem = new T[new_capacity]; 

		// copy new elements into bigger array
		try
		{
		
			for (std::size_t i = 0; i < array_size; i++){
				new_elem[i] = elem[i];
			}
		} catch (...){
			delete[] new_elem;
			throw;
		}
		// released old array (after copy succeeds) and switch to bigger array
		delete[] elem; 

		elem = new_elem; 
		space = new_capacity; 
		
	}

	void push_back(const T& value){
		if (array_size == space){
			if (space == 0) {
				reserve(1); // start with 1 if first element
			}else {
				reserve(space * 2); // double - keep push back fast
			}
			
			
		}  

		elem[array_size] = value; 
		array_size++;
	}

	T& at(std::size_t index){
		if (index >= array_size){
			throw std::out_of_range("Index out of range!");
		}

		return elem[index];

	}


	void pop_back() {
	if (array_size >= 0) 
	{
		
	} else {
		throw std::out_of_range("No data in the vector");
	} 

	if (array_size == 1) {
		
		
		array_size--;

	} else {
	    
		if (elem.end()){
		delete[] elem[last];
		array_size--;
		}
	}

	

	
	}

	bool empty() {
		if (array_size == 0) {
		return true;
	} else {
	return false;
	}
	}

	
	void clear() {
	for (int i = 0; i > array_size; i++){
	delete[] elem[i]; 
	}
	array_size = 0;
	

	}

};


#endif
